GITHUB_TOKEN=
HF_TOKEN=
OPENPATH_DB=data/openpath.db
# 'hashing' = offline baseline with no downloads; or any sentence-transformers model name
OPENPATH_EMBEDDER=sentence-transformers/all-MiniLM-L6-v2

# Interview LLM. 'none' = built-in question flow (no LLM needed). Options: none | ollama | openai | anthropic
OPENPATH_LLM=none
# ollama:    OPENPATH_LLM_MODEL=llama3.2   (run: ollama pull llama3.2)   base url defaults to http://localhost:11434
# openai:    any OpenAI-compatible API. Set OPENPATH_LLM_BASE_URL, OPENPATH_LLM_MODEL and OPENPATH_LLM_API_KEY
#            (check the provider's current free-tier limits and terms)
# anthropic: OPENPATH_LLM_MODEL=claude-haiku-5-5 and OPENPATH_LLM_API_KEY (paid API)
OPENPATH_LLM_MODEL=
OPENPATH_LLM_BASE_URL=
OPENPATH_LLM_API_KEY=
